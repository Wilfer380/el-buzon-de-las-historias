{
  "name": "el-buzon-de-las-historias",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --base=/el-buzon-de-las-historias/",
    "typecheck": "tsc -b --pretty false && tsc --ignoreConfig --noEmit --pretty false --target ES2022 --lib ES2022,DOM --module ESNext --moduleResolution Bundler --strict --skipLibCheck worker/index.ts",
    "test": "vitest",
    "e2e": "playwright test",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply el-buzon-historias --remote"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "4.4.1",
    "jsdom": "latest",
    "typescript": "latest",
    "vite": "6.4.6",
    "vitest": "3.2.7",
    "wrangler": "^4.164.0"
  }
}
